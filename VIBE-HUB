local function spotifyPlay(index)
    local track = HOTHX_SPOTIFY_TRACKS[index]
    if not track then return end
    if not track.audioAsset then
        setStatus("Missing local file: " .. tostring(track.audio))
        return
    end
    SpotifyCurrentIndex = index
    SpotifySound:Stop()
    SpotifySound.SoundId = track.audioAsset
    SpotifySound.TimePosition = 0
    local ok = pcall(function() SpotifySound:Play() end)
    spotifyUpdateMain()
    spotifyUpdatePlayIcon()
    if ok then
        setStatus("Playing " .. track.title)
    else
        setStatus("Could not play local audio")
    end
end
